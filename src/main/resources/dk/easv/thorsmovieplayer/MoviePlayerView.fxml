<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="dk.easv.thorsmovieplayer.GUI.Controller.MoviePlayerController">

    <!-- TOP -->
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Add Movie" />
                <MenuItem text="Remove Movie" />
                <SeparatorMenuItem />
                <MenuItem text="Exit" />
            </Menu>
            <Menu text="Categories">
                <MenuItem text="Add Category" />
                <MenuItem text="Remove Category" />
            </Menu>
            <Menu text="About" />
        </MenuBar>
    </top>

    <!-- LEFT: FILTERS -->
    <left>
        <VBox spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Label style="-fx-font-size: 16px;" text="Filters" />

            <Label text="Title" />
            <TextField fx:id="titleFilterField" promptText="Search by title" />

            <Label text="Genres" />
            <ListView fx:id="genreListView" prefHeight="150" />

            <Label text="Min IMDB Rating" />
            <Slider fx:id="ratingSlider" max="10" min="0" showTickLabels="true" value="0" />

            <Button onAction="#clearFilters" text="Clear Filters" />
        </VBox>
    </left>

    <!-- CENTER: MOVIE TABLE -->
    <center>
        <TableView fx:id="movieTable">
            <columns>
                <TableColumn fx:id="titleColumn" prefWidth="200" text="Title" />
                <TableColumn fx:id="categoryColumn" prefWidth="200" text="Categories" />
                <TableColumn fx:id="imdbColumn" prefWidth="80" text="IMDB" />
                <TableColumn fx:id="ratingColumn" prefWidth="120" text="My Rating" />
            </columns>
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
        </TableView>
    </center>

    <!-- RIGHT: DETAILS -->
    <right>
        <VBox spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Label style="-fx-font-size: 16px;" text="Movie Details" />

            <Label fx:id="detailTitle" />
            <Label fx:id="detailCategories" />
            <Label fx:id="detailImdb" />

            <Label text="My Rating" />
            <Slider fx:id="personalRatingSlider" max="5" min="0" value="0" />

            <Button onAction="#playMovie" text="Play Movie" />
        </VBox>
    </right>

</BorderPane>
